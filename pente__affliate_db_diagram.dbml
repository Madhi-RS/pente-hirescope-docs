Enum client_status {
  ONBOARDING
  REVIEW
  WON
  LOST
  SUSPENDED
}

Enum lead_source {
  referral
  website
  social
  direct
  other
}

Enum client_activity_type {
  CALL
  EMAIL
  MEETING
  OTHER
  SYSTEM
}

Enum commission_type {
  DIRECT
  OVERRIDE
}

Enum commission_status {
  EARNED
  APPROVED
  PAID
  DISPUTED
}

Enum product_category {
  website
  chatbot
  bundle
  other
}

Enum proposal_status {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

Enum proposal_item_type {
  PRODUCT
  CUSTOM
}

Enum question_type {
  TEXT
  TEXTAREA
  SELECT
  MULTI_SELECT
  FILE_UPLOAD
}

Enum response_status {
  SENT
  IN_PROGRESS
  SUBMITTED
}

Enum filled_by_type {
  CLIENT
  AFFILIATE
}

Enum enrollment_status {
  ENROLLED
  COMPLETED
}

Enum asset_category {
  brochure
  presentation
  email_template
  social_media
  case_study
  pricing
  video
  other
}

Enum recipient_type {
  ADMIN
  AFFILIATE
}

Enum ticket_status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

Enum ticket_priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

Enum ticket_author_type {
  ADMIN
  AFFILIATE
}

Enum order_status {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

Enum project_status {
  PLANNING
  DESIGN
  DEVELOPMENT
  QA
  CLIENT_REVIEW
  GO_LIVE
  COMPLETED
}

Enum activity_type {
  STAGE_CHANGE
  NOTE_ADDED
  ASSIGNED
  WON
  LOST
}

Enum actor_type {
  ADMIN
  AFFILIATE
}

// ============================================================
// TABLE RELATIONSHIPS SUMMARY
// ============================================================
// admins 1──* audit_logs
// admins 1──* affiliates (reviewed_by)
// admins 1──* commission_payouts
// admins 1──* products
// admins 1──* courses
// admins 1──* marketing_assets
// admins 1──* support_tickets (assigned_to)
// admins 1──* support_ticket_replies
// admins 1──* knowledge_base_articles
//
// affiliates 1──1 branding_configs
// affiliates 1──1 landing_pages
// affiliates 1──* affiliates (parent_affiliate_id — self-referencing)
// affiliates 1──* prospects
// affiliates 1──* leads
// affiliates 1──* clients
// affiliates 1──* commission_records
// affiliates 1──* proposals
// affiliates 1──* questionnaire_responses
// affiliates 1──* course_enrollments
// affiliates 1──* marketing_asset_downloads
// affiliates 1──* support_tickets
//
// prospects 1──* prospect_contacts
// prospects 1──* prospect_notes
// prospects 0..1──1 leads (converted_to_lead_id)
//
// leads 1──* lead_activities
// leads 0..1──1 clients
// leads 0..1──1 prospects
//
// clients 1──* client_contacts
// clients 1──* client_notes
// clients 1──* client_activities
// clients 1──* website_orders
// clients 1──* website_projects
//
// commission_records 0..1──* commission_records (parent_commission_id — self-referencing)
// commission_records *──* commission_payouts (via commission_payout_items)
//
// products 1──* product_tiers
// products 1──* proposal_items
//
// proposals 1──* proposal_items
//
// questionnaire_templates 1──* questionnaire_sections
// questionnaire_sections 1──* questionnaire_questions
// questionnaire_responses 1──* questionnaire_answers
//
// courses 1──* course_lessons
// courses 1──* course_enrollments
// course_enrollments 1──* lesson_completions
//
// website_orders 1──* website_projects
// website_projects 1──* website_project_statuses
// ============================================================
