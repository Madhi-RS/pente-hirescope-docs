  INVITED
  ACTIVE
  SUSPENDED
  DELETED
  EXPIRED
}

Enum prospect_status {
  NEW
  RESEARCHED
  CONTACTED
  CONVERTED
  DISQUALIFIED
}

Enum contact_method {
  CALL
  EMAIL
  IN_PERSON
  OTHER
}

